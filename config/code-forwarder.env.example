# Copy these exports into your shell profile or launchd environment.
# The request-viaplay-code flow will source this file when CONFIG_ENV_FILE points here.

# Trigger detection.
export TRIGGER_ACCOUNT="whatsapp"
export TRIGGER_PHRASE="viaplay code"
export TRIGGER_MAX_AGE_MINUTES="0"
export TRIGGER_SOURCE="openclaw_gateway_log"
export GATEWAY_LOG_FILE="$HOME/.openclaw/logs/gateway.log"
export GATEWAY_LOG_SCAN_LINES="5000"

# Mail lookup.
export MAIL_ACCOUNT="bennyskov@hotmail.com"
export SENDER_FILTER="viaplay"
export SUBJECT_PHRASE="midlertidig engangskode"
export MAIL_SCAN_LIMIT="1440"

# Forward/reply behavior.
export FORWARD_TO="bsjunk13@hotmail.com"
export FORWARD_EMAIL="true"
export DELETE_SOURCE_EMAIL="true"
export REPLY_PREFIX="Viaplay kode"

# Request allowlist.
# Only enabled targets from DESTINATIONS_FILE are allowed to trigger a reply.
export DESTINATIONS_FILE="$HOME/_PROJECTS/AI-projects/bs-openclaw/config/code-forward-destinations.csv"

# Logging and dedup.
export STATE_FILE="$HOME/_PROJECTS/AI-projects/bs-openclaw/logs/request-viaplay-code.state"
export LOG_FILE="$HOME/_PROJECTS/AI-projects/bs-openclaw/logs/request-viaplay-code.log"
# Optional: clear LOG_FILE after each successful WhatsApp send.
export CLEAR_LOG_ON_REPLY_SENT="true"

# Validation/test mode.
export DRY_RUN="false"
