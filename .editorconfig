# EditorConfig configuration for SolarWinds Management Tools
# Follows project standards and instructions from .github/prompts/editorconfig.prompt.md
root = true

# Universal settings
[*]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# PowerShell Scripts and Modules
# Matches sw_tool_template.ps1 style (2 spaces)
[*.{ps1,psm1,psd1}]
indent_size = 2

# Database Queries (SQL, SWQL)
# Often requires different alignment, defaulting to 4 for readability
[*.{sql,swql}]
indent_size = 4

# XML and Configuration Files
[*.{xml,config,apm-template,csproj,isml}]
indent_size = 2

# Batch Files
[*.{cmd,bat}]
indent_size = 2

# Markdown Documentation
[*.{md,markdown}]
trim_trailing_whitespace = false
